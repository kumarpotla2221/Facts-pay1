# schools.json says where each school's database is. .env holds only the secrets and switches (never commit it).
# Local dev uses the Heroku demo database, so .env is simply the app's own settings:
#   heroku config -a facts-pay --shell | grep -v '^MSSQL_' > .env

PAY_RANCHI_PASS=CHANGE_ME       # one DB password per school, always PAY_<SLUG>_PASS (the login schools-sql/setup.sql creates). Never in schools.json.

# Supabase/PostgreSQL alternative. Backend only; see SUPABASE.md for migration and least-privilege login setup.
# PAY_RANCHI_DATABASE_URL=postgresql://ROLE.PROJECT_REF:ENCODED_ROLE_PASSWORD@POOLER_HOST:6543/postgres
# PAY_RANCHI_SCHEMA=school_ranchi
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# SUPABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres

# Receipt emails (PDF attached), sent straight through your SMTP provider. Empty = no emails.
# Gmail: an App Password (Google account > Security > 2-Step Verification > App passwords), then
#   SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465   (the @ in the user name is written %40)
SMTP_URL=smtps://USER:PASS@smtp.provider.com:465
MAIL_FROM="Facts Pay <receipts@facts-pay.local>"

MOCK_GATEWAY=1                  # fake "Pay" button. Must be 0 with a real gateway.
# DEMO_ADMISSION=DEMO001         # optional sample admission shown only when mock checkout is enabled

# DB_TRUST_CERT=1 for a SQL Server with a self-signed certificate. PORT defaults to 4000.
