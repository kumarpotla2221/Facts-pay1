{
  "name": "facts-pay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "npm run dev:api --",
    "dev:api": "npm run dev --workspace @facts-pay/api --",
    "dev:mobile": "npm run start --workspace @facts-pay/mobile --",
    "android": "npm run android --workspace @facts-pay/mobile --",
    "ios": "npm run ios --workspace @facts-pay/mobile --",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @facts-pay/api",
    "build:mobile": "npm run build --workspace @facts-pay/mobile",
    "start": "npm run start --workspace @facts-pay/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace @facts-pay/mobile",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration --workspace @facts-pay/api"
  }
}
