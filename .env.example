# Copy to .env (`cp .env.example .env`) and replace every CHANGE_ME. Never commit .env.

# SQL Server admin of the LOCAL dev container. Used only by docker compose and tools/*.sh, never by the API.
SA_PASSWORD=CHANGE_ME

# One DB password per school. schools.json refers to these by NAME (db.passwordEnv), never stores them.
# tools/restore-ranchi.sh creates the Ranchi login with this password (and adds the line if it is missing).
PAY_RANCHI_PASS=CHANGE_ME

SCHOOL_DB_HOST=localhost        # host-run API/tests only: schools.json says `mssql` (the Docker name), this overrides it
# SCHOOL_DB_NAME= / SCHOOL_DB_USER= / SCHOOL_DB_ADMIN_USER=   a copy of the database elsewhere (the Heroku MSSQL add-on): see README
DB_TRUST_CERT=1                 # 0 when the SQL Server has a real certificate

# Receipt emails (PDF attached), sent straight through your SMTP provider. Empty = no emails.
# Gmail: an App Password (Google account > Security > 2-Step Verification > App passwords), then
#   SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465   (the @ in the user name is written %40)
SMTP_URL=smtps://USER:PASS@smtp.provider.com:465
MAIL_FROM="Facts Pay <receipts@facts-pay.local>"

MOCK_GATEWAY=1                  # fake "Pay" button. Must be 0 with a real gateway.
PORT=4000
